/* Live Chat */
#liveChatTrigger {
    position: fixed;
    bottom: 110px;
    right: 30px;
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, var(--primary-pink), var(--gold));
    color: white;
    border: none;
    border-radius: 50%;
    font-size: 1.5rem;
    cursor: pointer;
    box-shadow: var(--shadow-lg);
    z-index: 998;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
}

